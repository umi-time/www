---
const { children } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Umi‑Time</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Umi‑Time is a solar‑aligned time system based on umi units instead of civil clock hours."
    />

    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <script src="../scripts/umi-live-time.js"></script>
  </head>

  <body>
    <header class="umi-header">
      <div class="umi-region">
        <div class="logo">
          <span class="logo-mark"></span>
          <a href="/">Umi‑Time</a>
          <span id="umi-live-time" class="umi-live-time"></span>
        </div>
        <nav class="umi-nav">
          <a href="/manifesto">Manifesto</a>
          <a href="/map-demo">Demo</a>
          <a href="/clock">Clock</a>
          <a href="/spec">Specification</a>
        </nav>
      </div>
    </header>

    <div class="primary-content">
      <slot />
    </div>

    <footer class="umi-footer">
      <div class="umi-footer-inner">
        <div class="umi-footer-section">
          <div class="umi-footer-title">Documentation</div>
          <a href="/about">About Umi‑Time</a>
          <a href="/getting-started">Getting Started</a>
          <a href="/faq">FAQ</a>
          <a href="/design">Design Principles</a>
        </div>

        <div class="umi-footer-section">
          <div class="umi-footer-title">Developer</div>
          <a href="/api">API Reference</a>
          <a href="/examples">Examples & Demos</a>
          <a href="/download">Download / Install</a>
        </div>

        <div class="umi-footer-section">
          <div class="umi-footer-title">Project</div>
          <a href="/roadmap">Roadmap</a>
          <a href="/contributing">Contributing</a>
          <a href="/release-notes">Release Notes</a>
          <a href="https://github.com/umi-time" target="_blank">GitHub</a>
        </div>

        <div class="umi-footer-meta">
          <p>
            &copy; <span id="footer-year">2026</span> Daniel Brannon and Umi‑Time contributors.<br />Umi‑Time is
            an <open-source>open-source project</open-source>.
          </p>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const yearSpan = document.getElementById("footer-year");
        if (yearSpan)
          yearSpan.textContent = new Date().getFullYear().toString();
      });
    </script>
  </body>
</html>
