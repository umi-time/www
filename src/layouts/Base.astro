---
const { children } = Astro.props;
import { fingerprint } from "../scripts/utils/fingerprint.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Umi‑Time</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Umi‑Time is an open standard for presenting UTC in a locally meaningful way."
    />
    <meta
      property="og:title"
      content="Umi‑Time — Universal Time, Locally Meaningful"
    />
    <meta
      property="og:description"
      content="Umi‑Time is an open standard for presenting UTC in a locally meaningful way."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://umitime.com" />
    <meta property="og:image" content="https://umitime.com/og-image.png" />
    <meta property="og:site_name" content="Umi‑Time" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Umi‑Time",
        "url": "https://umitime.com",
        "description": "Umi‑Time is an open standard for presenting UTC in a locally meaningful way.",
        "publisher": {
          "@type": "Organization",
          "name": "Umi‑Time"
        }
      }
    </script>

    <link rel="icon" href={fingerprint("/favicon.ico")} sizes="any" />
    <link rel="icon" href={fingerprint("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={fingerprint("/apple-touch-icon.png")} />
    <link rel="manifest" href={fingerprint("/site.webmanifest")} />

    <link rel="stylesheet" href={fingerprint("/css/layout.css")} />
    <script src="../scripts/umi-live-time.js"></script>

    <slot name="head" />
  </head>

  <body>
    <header class="umi-header">
      <div class="umi-region">
        <div class="logo">
          <span class="logo-mark"></span>
          <a href="/">Umi‑Time</a>
          <span id="umi-live-time" class="umi-live-time"></span>
        </div>
        <button id="mobile-menu-button" class="mobile-menu-button">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav class="umi-nav">
          <a href="/manifesto">Manifesto</a>
          <a href="/world-map">World Map</a>
          <a href="/clock">Clock</a>
          <a href="/spec">Specification</a>
        </nav>
      </div>
    </header>

    <div class="primary-content">
      <slot />
    </div>

    <footer class="umi-footer">
      <div class="umi-footer-inner">
        <div class="umi-footer-section">
          <div class="umi-footer-title">Documentation</div>
          <a href="/about">About Umi‑Time</a>
          <a href="/getting-started">Getting Started</a>
          <a href="/faq">FAQ</a>
          <a href="/design">Design Principles</a>
        </div>

        <div class="umi-footer-section">
          <div class="umi-footer-title">Developer</div>
          <a href="/api">API Reference</a>
          <a href="/examples">Examples & Demos</a>
          <a href="/install">Install</a>
          <a
            href="https://github.com/umi-time"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>

        <div class="umi-footer-section">
          <div class="umi-footer-title">Project</div>
          <a href="/roadmap">Roadmap</a>
          <a href="/contributing">Contributing</a>
          <a href="/release-notes">Release Notes</a>
          <a href="/licensing">Licensing</a>
        </div>

        <div class="umi-footer-meta">
          <p>
            &copy; <span id="footer-year">2026</span> Daniel Brannon and Umi‑Time
            contributors.<br />
            Umi‑Time is an open‑source project.
          </p>
        </div>
      </div>
    </footer>
    <div id="mobile-nav" class="mobile-nav">
      <div class="mobile-nav-section">
        <div class="mobile-nav-links">
          <a href="/manifesto">Manifesto</a>
          <a href="/world-map">World Map</a>
          <a href="/clock">Clock</a>
          <a href="/spec">Specification</a>
        </div>
      </div>

      <div class="mobile-nav-section">
        <div class="mobile-nav-title">Documentation</div>

        <div class="mobile-nav-links">
          <a href="/about">About Umi‑Time</a>
          <a href="/getting-started">Getting Started</a>
          <a href="/faq">FAQ</a>
          <a href="/design">Design Principles</a>
        </div>
      </div>

      <div class="mobile-nav-section">
        <div class="mobile-nav-title">Developer</div>

        <div class="mobile-nav-links">
          <a href="/api">API Reference</a>
          <a href="/examples">Examples & Demos</a>
          <a href="/install">Install</a>
          <a
            href="https://github.com/umi-time"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>
      </div>

      <div class="mobile-nav-section">
        <div class="mobile-nav-title">Project</div>

        <div class="mobile-nav-links">
          <a href="/roadmap">Roadmap</a>
          <a href="/contributing">Contributing</a>
          <a href="/release-notes">Release Notes</a>
          <a href="/licensing">Licensing</a>
        </div>
      </div>
    </div>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const yearSpan = document.getElementById("footer-year");
        if (yearSpan)
          yearSpan.textContent = new Date().getFullYear().toString();

        const button = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-nav");

        button?.addEventListener("click", (event) => {
          event.stopPropagation();
          menu?.classList.toggle("open");
          button?.classList.toggle("open");
        });

        menu?.addEventListener("click", (event) => {
          event.stopPropagation();
        });

        document.addEventListener("click", () => {
          menu?.classList.remove("open");
          button?.classList.remove("open");
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {});
    </script>
  </body>
</html>
