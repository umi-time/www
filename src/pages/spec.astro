---
import Base from '../layouts/Base.astro';
import specHtmlRaw from '../../spec/spec.html?raw';
import { fingerprint } from "../scripts/utils/fingerprint.js";

  const match = specHtmlRaw.match(
    /<!-- BEGIN CONTENT -->([\s\S]*?)<!-- END CONTENT -->/
  );

  const specHtml = match ? match[1] : specHtmlRaw;   
---

<Base>
  <slot slot="head">
    <!-- Load styles from your served static folder -->
    <link rel="stylesheet" href={fingerprint("/css/spec.css")} />

    <!-- Configure MathJax targeting absolute root assets -->
    <script is:inline>
      window.MathJax = {
        chtml: {
          fontURL: '/vendor/mathjax-full/es5/output/chtml/fonts/woff-v2'
        }
      };
    </script>
    <script is:inline src={fingerprint("/vendor/mathjax-full/es5/tex-mml-chtml.js")}></script>
    <script is:inline src={fingerprint("/js/spec.js")} defer></script>
  </slot>


  <!-- Processed HTML spec content -->
  <div set:html={specHtml}></div>
</Base>
