---
import Layout from "../layouts/Base.astro";
import { fingerprint } from "../scripts/utils/fingerprint.js";
---

<!--
This is a custom clock implementation that uses a non-standard time keeping system.
It is closely related to UTC, but instead of hh:mm:ss time format, it uses a uuu:sss format,
where the umi range from 0-359, and the seconds range from 0-239.
The clock display has an outer solar ring showing a gradient to represent different parts of the local day,
including sunrise, daytime, sunset and nighttime. It also has an inner dial with markings for the umi.
The inner dial is rotated by an amount equal to the longitude.
The sunrise and sunset times are variable based on the date and latitude.
When the latitude and longitude are set correctly, this clock can be used in any location in the world.
-->
<Layout title="Umi‑Time Clock">
  <div class="umi-region-full clock-page">
    <main>
      <section class="section-header">
        <!-- Configuration toggle button -->
        <button
          id="configurationToggle"
          class="configuration-btn"
          aria-label="Toggle configuration"
        >
          ⚙️
        </button>

        <!-- Fullscreen toggle button -->
        <button
          id="fullscreenToggle"
          class="fullscreen-btn"
          aria-label="Toggle fullscreen"
        >
          ⛶
        </button>

        <div id="configurationRegion">
          <div id="controlPanel" class="control-panel" style="display:none">
            <label>
              <span title="Location">📍</span>
              <select id="locationSelect"></select>
            </label>

            <label class="tips-toggle">
              <input id="showTips" type="checkbox" checked />
              <span>Show Tips</span>
            </label>
          </div>

          <div id="tipsPanel" class="tips-panel">
            <div id="tipText">
              <div id="tip-1" class="tip active">
                <div class="tip-focus">Umi‑Time</div>
                <div class="tip-explanation">
                  It shows UTC in a locally meaningful way.
                </div>
              </div>

              <div id="tip-2" class="tip">
                <div class="tip-focus">Notice the larger number.</div>
                <div class="tip-explanation">It is the current Umi‑Time.</div>
              </div>

              <div id="tip-3" class="tip">
                <div class="tip-focus">Notice the umi symbol.</div>
                <div class="tip-explanation">Umi are units of time.</div>
              </div>

              <div id="tip-4" class="tip">
                <div class="tip-focus">Notice the smaller number.</div>
                <div class="tip-explanation">
                  It shows the current umi-second.
                </div>
              </div>

              <div id="tip-5" class="tip">
                <div class="tip-focus">Notice the values around the dial.</div>
                <div class="tip-explanation">They are umi values.</div>
              </div>

              <div id="tip-6" class="tip">
                <div class="tip-focus">Notice the large hand.</div>
                <div class="tip-explanation">It points to the current umi.</div>
              </div>

              <div id="tip-7" class="tip">
                <div class="tip-focus">Notice the thin hand.</div>
                <div class="tip-explanation">
                  It shows the seconds within the current umi.
                </div>
              </div>

              <div id="tip-8" class="tip">
                <div class="tip-focus">Notice the dial.</div>
                <div class="tip-explanation">It rotates with longitude.</div>
              </div>

              <div id="tip-9" class="tip">
                <div class="tip-focus">Notice the top of the dial.</div>
                <div class="tip-explanation">
                  It always represents local solar noon.
                </div>
              </div>

              <div id="tip-10" class="tip">
                <div class="tip-focus">Notice the bottom of the dial.</div>
                <div class="tip-explanation">
                  It always represents local solar midnight.
                </div>
              </div>

              <div id="tip-11" class="tip">
                <div class="tip-focus">Notice the colored ring.</div>
                <div class="tip-explanation">
                  It shows daylight, twilight, and night.
                </div>
              </div>

              <div id="tip-12" class="tip">
                <div class="tip-focus">Notice the lit bezel segment.</div>
                <div class="tip-explanation">
                  It shows the current local hour.
                </div>
              </div>

              <div id="tip-13" class="tip">
                <div class="tip-focus">Notice that the bezel is fixed.</div>
                <div class="tip-explanation">
                  It provides a reference for your local solar day.
                </div>
              </div>

              <div id="tip-14" class="tip">
                <div class="tip-focus">← Notice the city selector.</div>
                <div class="tip-explanation">
                  Try viewing the clock from another location.
                </div>
              </div>

              <div id="tip-15" class="tip">
                <div class="tip-focus">Try another city.</div>
                <div class="tip-explanation">
                  The Umi‑Time stays the same everywhere on Earth.
                </div>
              </div>

              <div id="tip-16" class="tip">
                <div class="tip-focus">Notice what changed.</div>
                <div class="tip-explanation">
                  The dial rotates, but the Umi‑Time does not change.
                </div>
              </div>

              <div id="tip-17" class="tip">
                <div class="tip-focus">Notice what stayed the same.</div>
                <div class="tip-explanation">
                  Everyone on Earth shares the same Umi‑Time.
                </div>
              </div>

              <div id="tip-18" class="tip">
                <div class="tip-focus">Notice the conceptual layers.</div>
                <div class="tip-explanation">
                  1. UTC 2. Umi‑Time 3. local day 4. solar events.
                </div>
              </div>

              <div id="tip-19" class="tip">
                <div class="tip-focus">Notice the clock as a whole.</div>
                <div class="tip-explanation">
                  It shows universal time personalized for your location.
                </div>
              </div>

              <div id="tip-20" class="tip">
                <div class="tip-focus">Notice the relationship to UTC.</div>
                <div class="tip-explanation">
                  0<sup>u</sup> occurs at UTC midnight.
                </div>
              </div>

              <div id="tip-21" class="tip">
                <div class="tip-focus">Notice the size of a day.</div>
                <div class="tip-explanation">A day contains 360 umi.</div>
              </div>

              <div id="tip-22" class="tip">
                <div class="tip-focus">Notice the size of an umi.</div>
                <div class="tip-explanation">
                  Each umi contains exactly 240 seconds.
                </div>
              </div>

              <div id="tip-23" class="tip">
                <div class="tip-focus">Notice the simplicity.</div>
                <div class="tip-explanation">
                  Umi‑Time uses the same seconds as UTC.
                </div>
              </div>

              <div id="tip-24" class="tip">
                <div class="tip-focus">Notice the advantage.</div>
                <div class="tip-explanation">
                  One global time. Many local experiences.
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div id="clockWrapper">
        <umi-clock
          id="umi-clock"
          latitude="0"
          longitude="0"
          size="350px"
          dark="true"></umi-clock>
      </div>
    </main>
  </div>

  <link rel="stylesheet" href={fingerprint("/css/button.css")} />
  <link rel="stylesheet" href={fingerprint("/css/clock.css")} />

  <script src="/src/components/umi-clock.js"></script>
  <script src="../scripts/clock.js"></script>
</Layout>
